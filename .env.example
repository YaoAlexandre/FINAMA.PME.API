# ─── CONFIGURATION DE L'ENVIRONNEMENT ─────────────────────────────────────────
# Options : Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# ─── BASE DE DONNÉES ──────────────────────────────────────────────────────────
# Format PostgreSQL pour production
# ⚠️ NE JAMAIS mettre les credentials en dur dans git !
# À injecter via variables d'environnement du host (Docker, Render, Railway, etc.)
ConnectionStrings__DefaultConnection=Host=POSTGRES_HOST;Port=5432;Database=POSTGRES_DATABASE;Username=POSTGRES_USER;Password=POSTGRES_PASSWORD;

# Alternative : SQLite pour tests/dev local uniquement
# ConnectionStrings__DefaultConnection=Data Source=finama.db;

# ─── SÉCURITÉ & AUTHENTIFICATION JWT ──────────────────────────────────────────
# Générer avec: dotnet user-secrets set Jwt__SecretKey "$(openssl rand -base64 32)"
# Ou : https://www.random.org/strings/ (128 caractères minimum en production)
Jwt__SecretKey=YOUR_GENERATED_SECRET_KEY_HERE_32_CHARS_MIN
Jwt__Issuer=Finama
Jwt__Audience=Finama.Clients
Jwt__AccessTokenDureeMinutes=60
Jwt__RefreshTokenDureeJours=30

# ─── CONFIGURATION EMAILS ──────────────────────────────────────────────────────
# Recommandation : Resend (SMTP ou API)
# À générer depuis https://resend.com/api-keys

# Option 1 : Resend API (recommandé)
Resend__ApiKey=YOUR_RESEND_API_KEY_HERE
EmailSettings__FromEmail=noreply@votredomaine.com
EmailSettings__FromName=Finama

# Option 2 : SMTP générique (Gmail, Brevo, etc.)
# EmailSettings__SmtpHost=smtp.gmail.com
# EmailSettings__SmtpPort=587
# EmailSettings__Username=your-email@gmail.com
# EmailSettings__Password=your-app-password-here
# EmailSettings__UseSSL=true

# ─── INTÉGRATIONS TIERCES ──────────────────────────────────────────────────────
# OAuth Google (optionnel)
GoogleAuth__ClientId=YOUR_GOOGLE_CLIENT_ID
GoogleAuth__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET

# Stripe ou autre payment provider (optionnel)
# Stripe__ApiKey=sk_live_xxx
# Stripe__WebhookSecret=whsec_xxx

# ─── LOGS & MONITORING ────────────────────────────────────────────────────────
# Pour Sentry, DataDog, ou autre
# Sentry__Dsn=https://xxx@sentry.io/123456
LogLevel__Default=Information
LogLevel__Microsoft=Warning

# ─── VOLUMES/UPLOADS (si applicable) ───────────────────────────────────────────
UploadPath=/app/uploads
MaxUploadSizeMB=50

# ─── CORS & SÉCURITÉ ───────────────────────────────────────────────────────────
AllowedHosts=*
# En production, à spécifier : AllowedHosts=votredomaine.com,www.votredomaine.com
