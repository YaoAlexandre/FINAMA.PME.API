# ==============================================================================
# FINAMA - Fichier de configuration modèle (Template)
# ⚠️ NE JAMAIS METTRE VOS VRAIES VALEURS DANS CE FICHIER SI VOUS L'ENVOYEZ SUR GIT
# ==============================================================================

# ─── ENVIRONNEMENT ────────────────────────────────────────────────────────────
# Options : Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# ─── BASE DE DONNÉES (PostgreSQL) ─────────────────────────────────────────────
# Remplacez par vos informations réelles fournies par l'hébergeur
ConnectionStrings__DefaultConnection=Host=db.votre-serveur.com;Port=5432;Database=finama_db;Username=admin_user;Password=un_mot_de_passe_tres_long_et_securise;

# ─── SÉCURITÉ JWT ─────────────────────────────────────────────────────────────
# IMPORTANT : Utilisez une chaîne aléatoire de 32 caractères minimum
Jwt__SecretKey=CeciEstUneCleSecreteDe32CaracteresMinimumPourLaProduction
Jwt__Issuer=Finama
Jwt__Audience=Finama.Clients
Jwt__AccessTokenDureeMinutes=60
Jwt__RefreshTokenDureeJours=30

# ─── CONFIGURATION EMAILS (Resend) ────────────────────────────────────────────
Resend__ApiKey=re_votre_cle_api_fictive_123456
EmailSettings__FromEmail=noreply@votre-domaine.com
EmailSettings__FromName=Finama

# ─── CACHE (Redis) ────────────────────────────────────────────────────────────
REDIS_PASSWORD=un_mot_de_passe_redis_tres_fort

# ─── LOGS & MONITORING ────────────────────────────────────────────────────────
LogLevel__Default=Information
LogLevel__Microsoft=Warning

# ─── STOCKAGE FICHIERS ────────────────────────────────────────────────────────
UploadPath=/app/uploads
MaxUploadSizeMB=50

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Remplacez par l'URL de votre front-end déployé
AllowedHosts=https://votre-application-web.onrender.com