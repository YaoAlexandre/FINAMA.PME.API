# Phase 1 : Base d'exécution pour la production
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:10000
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 10000

# Phase 2 : Restauration et build du projet
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Copie des fichiers de projet pour toutes les dépendances locales
COPY ["Finama.API/Finama.API.csproj", "Finama.API/"]
COPY ["Finama.Core/Finama.Core.csproj", "Finama.Core/"]
COPY ["Finama.Infrastructure/Finama.Infrastructure.csproj", "Finama.Infrastructure/"]

# Restauration des dépendances Nuget
RUN dotnet restore "./Finama.API/Finama.API.csproj"

# Copie de tout le code source
COPY . .
WORKDIR "/src/Finama.API"

# Build en mode Release
RUN dotnet build "./Finama.API.csproj" -c $BUILD_CONFIGURATION -o /app/build

# Phase 3 : Publication des binaires
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./Finama.API.csproj" \
    -c $BUILD_CONFIGURATION \
    -o /app/publish \
    /p:UseAppHost=false

# Phase 4 : Image finale d'exécution (slim)
FROM mcr.microsoft.com/dotnet/aspnet:9.0-alpine AS final
WORKDIR /app

# Métadonnées
LABEL maintainer="Alexander <vokouyaoalexandre@gmail.com>"
LABEL description="Finama API - SaaS Accounting Application"

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:10000/health || exit 1

# Copie des binaires publiés
COPY --from=publish /app/publish .

ENTRYPOINT ["dotnet", "Finama.API.dll"]
